# Get a free key at https://dev.helius.xyz
HELIUS_API_KEY=your-helius-api-key-here

# Required for PumpPortal live token-trade subscriptions.
# PumpPortal only streams per-token trades when the wallet linked to this key
# holds at least 0.02 SOL; without it the bot cannot observe any candidate.
PUMPPORTAL_API_KEY=your-pumpportal-api-key-here

# Safety switch: keep false for discovery/observation testing; set true only for live orders
LIVE_TRADING=false

# Optional: influencer signals from Telegram channels (https://my.telegram.org → API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
