{
  "name": "memecoin-trading-bot",
  "version": "1.0.0",
  "description": "Strategy-first Solana memecoin trading bot with plug-in entry strategies, live token discovery, safety checks, and automated exits.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "report": "tsx src/report.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "reset-paper": "tsx src/reset-paper.ts",
    "telegram-login": "tsx src/telegram-login.ts"
  },
  "keywords": [
    "solana",
    "memecoin",
    "trading-bot",
    "pumpfun",
    "raydium",
    "sniper",
    "helius",
    "jupiter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel493ferrer/memecoin-trading-bot.git"
  },
  "homepage": "https://github.com/daniel493ferrer/memecoin-trading-bot#readme",
  "bugs": {
    "url": "https://github.com/daniel493ferrer/memecoin-trading-bot/issues"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "teleproto": "^1.230.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
